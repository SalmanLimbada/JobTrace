{
  "manifest_version": 3,
  "name": "JobTrace",
  "version": "1.0.0",
  "description": "Clip job applications directly into your JobTrace tracker with one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobTrace Quick-Add"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ]
}
